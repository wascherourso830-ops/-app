rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId} (matches auth.uid)
    // Fields:
    //   - uid: string (required)
    //   - name: string (required)
    //   - gender: string (enum: male, female)
    //   - birthDate: string
    //   - birthTime: string
    //   - isTrueSolarTime: bool
    //   - checkInDates: list of strings
    //   - checkInStreak: int
    //
    // Collection: posts
    // Document ID: {postId}
    // Fields:
    //   - author: string (required)
    //   - authorUid: string (required)
    //   - content: string (required, max 500 chars)
    //   - createdAt: timestamp (required)
    //   - likes: int (required)
    //   - likedBy: list of strings (uids)
    //   - type: string (enum: fortune, healing, chart)
    //
    // Collection: users/{userId}/qa
    // Document ID: {qaId}
    // Fields:
    //   - userUid: string (required)
    //   - question: string (required, max 500 chars)
    //   - answer: string
    //   - createdAt: timestamp (required)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner() {
      return isAuthenticated() && request.auth.uid == resource.data.authorUid;
    }

    function isValidUser(data) {
      return data.uid == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             (!('gender' in data) || data.gender in ['male', 'female', 'other']) &&
             (!('birthDate' in data) || data.birthDate is string) &&
             (!('birthTime' in data) || data.birthTime is string) &&
             (!('isTrueSolarTime' in data) || data.isTrueSolarTime is bool) &&
             (!('checkInDates' in data) || data.checkInDates is list) &&
             (!('checkInStreak' in data) || data.checkInStreak is number) &&
             (!('profile' in data) || data.profile is map) &&
             (!('isSubscribed' in data) || data.isSubscribed is bool);
    }

    function isValidPost(data) {
      return data.keys().hasAll(['author', 'authorUid', 'content', 'createdAt', 'likes', 'type']) &&
             data.authorUid == request.auth.uid &&
             data.content is string && data.content.size() > 0 && data.content.size() < 1000 &&
             data.type in ['fortune', 'healing', 'chart', 'divination_help'] &&
             data.likes is int &&
             data.likedBy is list;
    }

    function isValidQA(data) {
      return data.keys().hasAll(['userUid', 'question', 'createdAt']) &&
             data.userUid == request.auth.uid &&
             data.question is string && data.question.size() > 0 && data.question.size() < 1000;
    }

    function isValidComment(data) {
      return data.keys().hasAll(['author', 'authorUid', 'content', 'createdAt']) &&
             data.authorUid == request.auth.uid &&
             data.content is string && data.content.size() > 0 && data.content.size() < 500;
    }

    function isValidDivinationHistory(data) {
      return data.keys().hasAll(['category', 'question', 'result', 'timestamp']) &&
             data.category is string &&
             (!('option' in data) || data.option == null || data.option is string) &&
             data.question is string &&
             data.result is map &&
             data.timestamp is timestamp &&
             (!('type' in data) || data.type is string) &&
             (!('ichingYao' in data) || data.ichingYao == null || data.ichingYao is list);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      // Allow reading specific public fields for leaderboard
      allow read: if isOwner(userId) || (isAuthenticated() && request.query.limit <= 10); 
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data);
      
      match /qa/{qaId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidQA(request.resource.data);
        allow update: if isOwner(userId) && isValidQA(request.resource.data);
      }

      match /divination_history/{historyId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidDivinationHistory(request.resource.data);
      }
    }

    match /posts/{postId} {
      allow read: if true; // Publicly readable
      allow create: if isAuthenticated() && isValidPost(request.resource.data);
      allow update: if isAuthenticated() && (
        // Owner can update their own post
        (isDocOwner() && isValidPost(request.resource.data)) ||
        // Others can only update the 'likes' and 'likedBy' fields (Liking logic)
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy']) &&
          math.abs(request.resource.data.likes - resource.data.likes) == 1 &&
          (
            // Like: uid not in likedBy before, but in after
            (request.resource.data.likes > resource.data.likes && 
             !(request.auth.uid in resource.data.likedBy) && 
             request.auth.uid in request.resource.data.likedBy) ||
            // Unlike: uid in likedBy before, but not after
            (request.resource.data.likes < resource.data.likes && 
             request.auth.uid in resource.data.likedBy && 
             !(request.auth.uid in request.resource.data.likedBy))
          )
        )
      );
      allow delete: if isDocOwner();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() && isValidComment(request.resource.data);
        allow delete: if isAuthenticated() && (request.auth.uid == resource.data.authorUid || isDocOwner());
      }
    }
  }
}
