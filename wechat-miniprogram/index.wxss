.container {
  min-height: 100vh;
  background-color: #F0F2F9;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  color: #374151;
  position: relative;
  overflow-x: hidden;
}

.fixed-bg {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  pointer-events: none;
}

.blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(80rpx);
  opacity: 0.4;
}

.blob-1 {
  width: 400rpx;
  height: 400rpx;
  background-color: #E9D5FF;
  top: -100rpx;
  left: -100rpx;
}

.blob-2 {
  width: 350rpx;
  height: 350rpx;
  background-color: #FCE7F3;
  top: 40%;
  right: -100rpx;
}

.blob-3 {
  width: 300rpx;
  height: 300rpx;
  background-color: #DBEAFE;
  bottom: 10%;
  left: 20%;
}

.main {
  position: relative;
  z-index: 1;
  padding: 40rpx 30rpx 100rpx;
}

.header {
  text-align: center;
  margin-bottom: 60rpx;
  padding-top: 40rpx;
}

.icon-box {
  display: inline-block;
  padding: 30rpx;
  background: #fff;
  border-radius: 60rpx;
  box-shadow: 0 20rpx 40rpx rgba(124, 58, 237, 0.1);
  margin-bottom: 30rpx;
  font-size: 40rpx;
}

.title {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: #111827;
  margin-bottom: 15rpx;
}

.subtitle {
  display: block;
  font-size: 24rpx;
  color: #6B7280;
  padding: 0 40rpx;
  line-height: 1.6;
}

.card {
  background: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(20rpx);
  border-radius: 50rpx;
  padding: 40rpx;
  box-shadow: 0 10rpx 30rpx rgba(124, 58, 237, 0.05);
  border: 2rpx solid #fff;
  margin-bottom: 40rpx;
}

.form-item {
  margin-bottom: 40rpx;
}

.label {
  font-size: 20rpx;
  font-weight: 900;
  color: #9CA3AF;
  text-transform: uppercase;
  letter-spacing: 4rpx;
  margin-left: 10rpx;
  margin-bottom: 15rpx;
}

.input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
}

.input-icon {
  position: absolute;
  left: 30rpx;
  font-size: 32rpx;
  color: #C4B5FD;
}

.input {
  width: 100%;
  height: 100rpx;
  background: rgba(249, 250, 251, 0.5);
  border-radius: 30rpx;
  padding: 0 40rpx 0 90rpx;
  font-size: 28rpx;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}

.input.small {
  line-height: 100rpx;
}

.gender-box {
  display: flex;
  background: rgba(249, 250, 251, 0.5);
  padding: 10rpx;
  border-radius: 30rpx;
  border: 2rpx solid #F3F4F6;
}

.gender-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 26rpx;
  font-weight: 700;
  color: #9CA3AF;
  border-radius: 20rpx;
  transition: all 0.3s;
}

.gender-btn.active {
  background: #fff;
  color: #7C3AED;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.05);
}

.row {
  display: flex;
}

.flex-1 { flex: 1; }
.mr-20 { margin-right: 20rpx; }

.solar-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 10rpx;
  margin-bottom: 40rpx;
}

.toggle-label {
  font-size: 22rpx;
  color: #9CA3AF;
  font-weight: 500;
}

.toggle-switch {
  width: 80rpx;
  height: 40rpx;
  background: #E5E7EB;
  border-radius: 20rpx;
  position: relative;
  transition: all 0.3s;
}

.toggle-switch.active {
  background: #7C3AED;
}

.toggle-dot {
  width: 30rpx;
  height: 30rpx;
  background: #fff;
  border-radius: 50%;
  position: absolute;
  top: 5rpx;
  left: 5rpx;
  transition: all 0.3s;
}

.toggle-switch.active .toggle-dot {
  left: 45rpx;
}

.submit-btn {
  width: 100%;
  height: 110rpx;
  background: linear-gradient(to right, #7C3AED, #4F46E5);
  color: #fff;
  border-radius: 40rpx;
  font-size: 32rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 20rpx 40rpx rgba(124, 58, 237, 0.2);
  border: none;
}

.footer-disclaimer {
  text-align: center;
  margin-top: 40rpx;
}

.disclaimer {
  font-size: 20rpx;
  color: #9CA3AF;
  background: rgba(255, 255, 255, 0.4);
  padding: 10rpx 30rpx;
  border-radius: 100rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.5);
}

/* Result Header */
.result-header {
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20rpx);
  padding: 80rpx 40rpx 0;
  position: sticky;
  top: 0;
  z-index: 100;
  border-bottom: 2rpx solid #F9FAFB;
}

.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 40rpx;
}

.back-btn {
  font-size: 40rpx;
  color: #9CA3AF;
  padding: 10rpx;
}

.page-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #111827;
}

.avatar {
  width: 70rpx;
  height: 70rpx;
  background: #F5F3FF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #7C3AED;
  font-weight: 800;
  font-size: 28rpx;
  border: 2rpx solid #DDD6FE;
}

.tabs {
  display: flex;
  justify-content: space-around;
}

.tab {
  padding: 30rpx 0;
  font-size: 28rpx;
  font-weight: 800;
  color: #9CA3AF;
  position: relative;
}

.tab.active {
  color: #7C3AED;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: #7C3AED;
  border-radius: 3rpx;
}

/* Overview Tab */
.summary-card {
  background: linear-gradient(to bottom right, #7C3AED, #4F46E5);
  color: #fff;
  padding: 60rpx;
  border: none;
  box-shadow: 0 30rpx 60rpx rgba(124, 58, 237, 0.2);
  position: relative;
  overflow: hidden;
}

.summary-card::after {
  content: '';
  position: absolute;
  top: -50rpx;
  right: -50rpx;
  width: 200rpx;
  height: 200rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
  filter: blur(40rpx);
}

.summary-label {
  font-size: 20rpx;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 6rpx;
  opacity: 0.6;
  margin-bottom: 20rpx;
}

.summary-text {
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.6;
  margin-bottom: 40rpx;
}

.summary-score {
  display: flex;
  align-items: baseline;
}

.score-num {
  font-size: 80rpx;
  font-weight: 900;
  margin-right: 15rpx;
}

.score-unit {
  font-size: 24rpx;
  opacity: 0.6;
}

.fortune-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.fortune-item {
  background: #fff;
  border-radius: 40rpx;
  padding: 30rpx;
  border: 2rpx solid #F3F4F6;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.02);
}

.fortune-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 15rpx;
}

.fortune-icon {
  font-size: 32rpx;
  padding: 10rpx;
  border-radius: 20rpx;
}

.love .fortune-icon { background: #FDF2F8; }
.career .fortune-icon { background: #EFF6FF; }
.wealth .fortune-icon { background: #FFFBEB; }
.health .fortune-icon { background: #ECFDF5; }

.fortune-score {
  font-size: 32rpx;
  font-weight: 900;
}

.love .fortune-score { color: #EC4899; }
.career .fortune-score { color: #3B82F6; }
.wealth .fortune-score { color: #D97706; }
.health .fortune-score { color: #10B981; }

.fortune-label {
  font-size: 20rpx;
  font-weight: 900;
  color: #9CA3AF;
  text-transform: uppercase;
  letter-spacing: 4rpx;
}

.section-header {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  font-weight: 900;
  color: #1F2937;
  margin-bottom: 30rpx;
  letter-spacing: 4rpx;
}

.bazi-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.bazi-row {
  display: flex;
  align-items: center;
  background: rgba(249, 250, 251, 0.5);
  padding: 30rpx;
  border-radius: 30rpx;
  border: 2rpx solid #F3F4F6;
}

.bazi-col-left {
  width: 100rpx;
  text-align: center;
  margin-right: 30rpx;
  border-right: 2rpx solid #E5E7EB;
  padding-right: 20rpx;
}

.bazi-label {
  display: block;
  font-size: 18rpx;
  color: #9CA3AF;
  font-weight: 700;
  margin-bottom: 5rpx;
}

.bazi-val {
  display: block;
  font-size: 32rpx;
  font-weight: 900;
  color: #1F2937;
}

.bazi-col-right {
  flex: 1;
}

.bazi-desc-title {
  display: block;
  font-size: 18rpx;
  color: #7C3AED;
  font-weight: 900;
  margin-bottom: 5rpx;
}

.bazi-vernacular {
  font-size: 22rpx;
  color: #6B7280;
  line-height: 1.5;
}

.content-text {
  font-size: 26rpx;
  color: #4B5563;
  line-height: 1.8;
}

/* Fortune Tab Detail */
.sub-tabs {
  display: flex;
  white-space: nowrap;
  margin-bottom: 40rpx;
}

.sub-tab {
  display: inline-flex;
  align-items: center;
  padding: 15rpx 40rpx;
  background: #fff;
  border-radius: 100rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: #9CA3AF;
  margin-right: 20rpx;
  border: 2rpx solid #F3F4F6;
}

.sub-tab.active {
  background: #7C3AED;
  color: #fff;
  border-color: #7C3AED;
  box-shadow: 0 10rpx 20rpx rgba(124, 58, 237, 0.2);
}

.sub-icon { margin-right: 10rpx; }

.detail-score-card {
  padding: 80rpx 40rpx;
  text-align: center;
  position: relative;
  overflow: hidden;
}

.detail-score-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 10rpx;
  background: #E5E7EB;
}

.detail-score-card:has(.love) ::before { background: #EC4899; }
.detail-score-card:has(.career) ::before { background: #3B82F6; }
.detail-score-card:has(.wealth) ::before { background: #D97706; }
.detail-score-card:has(.health) ::before { background: #10B981; }

.detail-score-header {
  font-size: 20rpx;
  font-weight: 900;
  color: #9CA3AF;
  text-transform: uppercase;
  letter-spacing: 6rpx;
  margin-bottom: 20rpx;
}

.detail-score-val {
  font-size: 140rpx;
  font-weight: 900;
  margin-bottom: 30rpx;
}

.detail-score-val.love { color: #EC4899; }
.detail-score-val.career { color: #3B82F6; }
.detail-score-val.wealth { color: #D97706; }
.detail-score-val.health { color: #10B981; }

.mood-tag {
  display: inline-flex;
  align-items: center;
  background: #F9FAFB;
  padding: 10rpx 30rpx;
  border-radius: 100rpx;
  border: 2rpx solid #F3F4F6;
}

.mood-label {
  font-size: 18rpx;
  font-weight: 900;
  color: #9CA3AF;
  margin-right: 15rpx;
}

.mood-val {
  font-size: 22rpx;
  font-weight: 800;
  color: #7C3AED;
}

.bullet-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.bullet-item {
  display: flex;
  align-items: flex-start;
  background: rgba(249, 250, 251, 0.5);
  padding: 30rpx;
  border-radius: 30rpx;
  border: 2rpx solid #F3F4F6;
}

.bullet-dot {
  width: 12rpx;
  height: 12rpx;
  background: #C4B5FD;
  border-radius: 50%;
  margin-top: 15rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.bullet-text {
  font-size: 26rpx;
  color: #4B5563;
  line-height: 1.6;
}

.quote-card {
  background: linear-gradient(to bottom right, #FFFBEB, #FFF7ED);
  border-color: #FEF3C7;
  text-align: center;
}

.quote-header {
  font-size: 20rpx;
  font-weight: 900;
  color: #D97706;
  text-transform: uppercase;
  letter-spacing: 6rpx;
  margin-bottom: 30rpx;
}

.quote-text {
  font-size: 32rpx;
  font-weight: 800;
  color: #92400E;
  line-height: 1.6;
  font-style: italic;
  margin-bottom: 30rpx;
}

.quote-footer {
  font-size: 22rpx;
  color: #B45309;
  opacity: 0.6;
}

/* Lucky Tab Detail */
.lucky-item-card {
  padding: 50rpx;
  margin-bottom: 30rpx;
}

.lucky-top {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}

.lucky-icon-box {
  width: 100rpx;
  height: 100rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 30rpx;
}

.lucky-icon-box.purple { background: #F5F3FF; color: #7C3AED; }
.lucky-icon-box.pink { background: #FDF2F8; color: #EC4899; }
.lucky-icon-box.blue { background: #EFF6FF; color: #3B82F6; }
.lucky-icon-box.orange { background: #FFF7ED; color: #D97706; }

.lucky-title-box {
  flex: 1;
}

.lucky-label {
  display: block;
  font-size: 20rpx;
  font-weight: 900;
  color: #9CA3AF;
  text-transform: uppercase;
  letter-spacing: 4rpx;
  margin-bottom: 5rpx;
}

.lucky-val {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #1F2937;
}

.lucky-usage {
  background: rgba(249, 250, 251, 0.5);
  padding: 20rpx 30rpx;
  border-radius: 20rpx;
  border: 2rpx solid #F3F4F6;
  margin-bottom: 20rpx;
}

.usage-label {
  display: block;
  font-size: 18rpx;
  font-weight: 900;
  color: #A78BFA;
  text-transform: uppercase;
  margin-bottom: 5rpx;
}

.usage-text {
  font-size: 22rpx;
  color: #6B7280;
}

.lucky-desc-text {
  font-size: 22rpx;
  color: #9CA3AF;
  font-style: italic;
  line-height: 1.5;
}

.task-card {
  background: #fff;
  border-color: #F3F4F6;
}

.task-box {
  display: flex;
  align-items: center;
  background: #F5F3FF;
  padding: 30rpx;
  border-radius: 30rpx;
  border: 2rpx solid #DDD6FE;
  margin-bottom: 20rpx;
}

.task-check {
  width: 40rpx;
  height: 40rpx;
  background: #fff;
  border-radius: 12rpx;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #DDD6FE;
}

.check-inner {
  width: 20rpx;
  height: 20rpx;
  background: #C4B5FD;
  border-radius: 6rpx;
}

.task-text {
  font-size: 28rpx;
  font-weight: 800;
  color: #4C1D95;
}

.task-basis {
  display: block;
  text-align: center;
  font-size: 20rpx;
  color: #9CA3AF;
}

/* Bottom Navigation */
.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  display: flex;
  justify-content: space-around;
  align-items: center;
  border-top: 2rpx solid #F3F4F6;
  z-index: 1000;
  padding-bottom: env(safe-area-inset-bottom);
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 10rpx 0;
  transition: all 0.3s;
}

.nav-icon {
  font-size: 40rpx;
  margin-bottom: 5rpx;
  opacity: 0.5;
  transition: all 0.3s;
}

.nav-label {
  font-size: 20rpx;
  font-weight: 800;
  color: #9CA3AF;
  transition: all 0.3s;
}

.nav-item.active .nav-icon {
  opacity: 1;
  transform: scale(1.2);
}

.nav-item.active .nav-label {
  color: #7C3AED;
}

/* Section Header Main */
.section-header-main {
  text-align: center;
  margin-bottom: 40rpx;
  padding-top: 40rpx;
}

/* Community Section */
.post-input-card {
  padding: 30rpx;
}

.post-textarea {
  width: 100%;
  height: 150rpx;
  font-size: 28rpx;
  color: #374151;
  margin-bottom: 20rpx;
}

.post-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.post-icon-btn {
  font-size: 40rpx;
  color: #9CA3AF;
}

.post-btn {
  background: #7C3AED;
  color: #fff;
  font-size: 24rpx;
  font-weight: 800;
  padding: 10rpx 40rpx;
  border-radius: 100rpx;
  margin: 0;
}

.post-card {
  padding: 30rpx;
}

.post-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.post-avatar {
  width: 80rpx;
  height: 80rpx;
  background: #F5F3FF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #7C3AED;
  font-weight: 800;
  margin-right: 20rpx;
}

.post-info {
  display: flex;
  flex-direction: column;
}

.post-author {
  font-size: 28rpx;
  font-weight: 800;
  color: #111827;
}

.post-time {
  font-size: 20rpx;
  color: #9CA3AF;
}

.post-content {
  font-size: 28rpx;
  color: #4B5563;
  line-height: 1.6;
  margin-bottom: 20rpx;
  display: block;
}

.post-footer {
  display: flex;
  align-items: center;
  border-top: 2rpx solid #F9FAFB;
  padding-top: 20rpx;
}

.post-action {
  display: flex;
  align-items: center;
  margin-right: 40rpx;
}

.action-icon {
  font-size: 32rpx;
  margin-right: 10rpx;
  color: #9CA3AF;
}

.action-icon.active {
  color: #EC4899;
}

.action-count {
  font-size: 22rpx;
  font-weight: 800;
  color: #9CA3AF;
}

/* Check-in Section */
.streak-card {
  text-align: center;
  padding: 60rpx 40rpx;
  background: linear-gradient(to bottom right, #7C3AED, #4F46E5);
  color: #fff;
  border: none;
}

.streak-info {
  margin-bottom: 40rpx;
}

.streak-label {
  font-size: 24rpx;
  opacity: 0.8;
  display: block;
  margin-bottom: 10rpx;
}

.streak-val-box {
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.streak-num {
  font-size: 100rpx;
  font-weight: 900;
  margin-right: 10rpx;
}

.streak-unit {
  font-size: 32rpx;
  font-weight: 800;
}

.checkin-btn {
  background: #fff;
  color: #7C3AED;
  font-size: 32rpx;
  font-weight: 800;
  border-radius: 100rpx;
  padding: 20rpx 80rpx;
  box-shadow: 0 10rpx 20rpx rgba(0, 0, 0, 0.1);
}

.calendar-card {
  padding: 40rpx;
}

.calendar-header {
  font-size: 28rpx;
  font-weight: 800;
  color: #111827;
  margin-bottom: 30rpx;
  text-align: center;
}

.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 15rpx;
}

.calendar-day {
  aspect-ratio: 1;
  background: #F9FAFB;
  border-radius: 15rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

.calendar-day.active {
  background: #F5F3FF;
  border: 2rpx solid #DDD6FE;
}

.day-num {
  font-size: 20rpx;
  color: #9CA3AF;
}

.calendar-day.active .day-num {
  color: #7C3AED;
  font-weight: 800;
}

.day-dot {
  width: 8rpx;
  height: 8rpx;
  background: #7C3AED;
  border-radius: 50%;
  position: absolute;
  bottom: 10rpx;
}

/* Q&A Section */
.qa-input-card {
  padding: 30rpx;
}

.qa-textarea {
  width: 100%;
  height: 150rpx;
  font-size: 28rpx;
  color: #374151;
  margin-bottom: 20rpx;
}

.qa-btn {
  background: #7C3AED;
  color: #fff;
  font-size: 28rpx;
  font-weight: 800;
  border-radius: 100rpx;
}

.qa-card {
  padding: 30rpx;
}

.qa-q, .qa-a {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.qa-tag {
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 900;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.qa-tag.q { background: #F5F3FF; color: #7C3AED; }
.qa-tag.a { background: #ECFDF5; color: #10B981; }

.qa-text {
  font-size: 26rpx;
  color: #4B5563;
  line-height: 1.6;
}

.qa-answer-box {
  flex: 1;
}

.loading-dots {
  display: flex;
  gap: 8rpx;
  padding: 10rpx 0;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  background: #10B981;
  border-radius: 50%;
  animation: bounce 1.4s infinite ease-in-out both;
}

.dot:nth-child(1) { animation-delay: -0.32s; }
.dot:nth-child(2) { animation-delay: -0.16s; }

@keyframes bounce {
  0%, 80%, 100% { transform: scale(0); }
  40% { transform: scale(1); }
}
